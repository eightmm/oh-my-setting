{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "oms-panel": {
      "type": "stdio",
      "command": "ssh",
      "args": [
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "ClearAllForwardings=yes",
        "-o",
        "ForwardAgent=no",
        "--",
        "oms-runtime",
        "exec env OMS_MCP_TOOL_PROFILE=chatgpt-panel OMS_PANEL_PROJECTS_FILE=\"${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-setting/desktop-projects.json\" \"$HOME/.local/bin/oms\" mcp-server"
      ],
      "env": { "OMS_MCP_PANEL_RESOURCE_VERSION": "v24" }
    }
  }
}
