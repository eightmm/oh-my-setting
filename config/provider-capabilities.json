{
  "schema": 1,
  "doc": "Per-provider, per-function support, derived from code paths and the tests that exercise them. Every supported/partial cell names its implementation (path::symbol, a definition) and test (path::name, a word that must occur in that file); tests/provider-registry-smoke.sh checks both. verified is fixture unless the repo records a live run; no cell here has one.",
  "statuses": {
    "supported": "code path exists and a test exercises it",
    "partial": "code path exists with the stated limit",
    "unsupported": "no code path",
    "unknown": "cannot be determined statically"
  },
  "functions": [
    {"id": "launch_main", "label": "launch a main session"},
    {"id": "worker_call", "label": "launch a worker / delegated call"},
    {"id": "observe", "label": "observe state (hooks or pane reading)"},
    {"id": "resume", "label": "resume an existing native session"},
    {"id": "send_message", "label": "send a message to a running session (steer / wake)"},
    {"id": "stop", "label": "stop / cancel"},
    {"id": "approval", "label": "relay an approval / permission request to the person"},
    {"id": "usage", "label": "report usage (context %, quota windows, tokens)"},
    {"id": "handoff", "label": "session handoff digest"}
  ],
