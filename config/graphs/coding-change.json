{
  "schema": 1,
  "id": "coding-change",
  "entry": "inspect",
  "budget": {"max_steps": 20, "max_repeats": 3},
  "stop_facts": [],
  "nodes": {
    "inspect": {
      "kind": "tool",
      "effect": "read",
      "title": "Project-graph context for the goal",
      "command": "oms graph project context --task \"${OMS_GRAPH_GOAL:-repository orientation}\" --json",
      "cacheable": true
    },
    "implement": {
      "kind": "agent",
      "effect": "write",
      "title": "Select the next ready plan task, bind it, and implement it in an isolated worktree",
      "plan_task": "next",
      "bind_task": "work_item",
      "mode": "run",
      "context": {"task": "${goal}", "max_files": 12},
      "proof": ["binding.work_item.patch_present", "binding.work_item.state=review"]
    },
    "review": {
      "kind": "gate",
      "authority": "parent",
      "title": "Parent reviews the stored patch",
      "decisions": ["approved", "changes_requested"]
    },
    "land": {
      "kind": "agent",
      "effect": "write",
      "title": "Admit and land the reviewed, bound task",
      "plan_task_from": "work_item",
      "mode": "land",
      "proof": ["binding.work_item.receipt.land.present", "binding.work_item.state=done"]
    },
    "commit": {
      "kind": "tool",
      "effect": "write",
      "title": "Commit exactly the landed patch of the bound task",
      "command": "oms graph exec commit --binding work_item",
      "proof": ["!git.dirty"]
    },
    "acceptance": {
      "kind": "tool",
      "effect": "read",
      "title": "Plan-level acceptance command",
      "command": "oms agent-plan accept",
      "proof": ["receipt.acceptance.latest=pass", "receipt.acceptance.fresh"]
    },
    "done": {"kind": "terminal", "title": "Change accepted"},
    "replan": {"kind": "terminal", "title": "Changes requested: the reviewed task waits for the parent to requeue it"},
    "parked": {"kind": "terminal", "title": "No actionable task, or the bound task could not land or commit"}
  },
  "edges": [
    {"from": "inspect", "to": "implement", "outcomes": ["completed", "unverified", "skipped", "failed"]},
    {"from": "implement", "to": "review", "outcomes": ["completed"]},
    {"from": "implement", "to": "implement", "outcomes": ["failed", "unverified"], "kind": "repeat"},
    {"from": "implement", "to": "parked", "outcomes": ["blocked"]},
    {"from": "review", "to": "replan", "outcomes": ["changes_requested"]},
    {"from": "review", "to": "land", "outcomes": ["approved"]},
    {"from": "land", "to": "commit", "outcomes": ["completed"]},
    {"from": "land", "to": "land", "outcomes": ["partial"], "kind": "repeat"},
    {"from": "land", "to": "parked", "outcomes": ["failed", "unverified", "blocked"]},
    {"from": "commit", "to": "acceptance", "outcomes": ["completed"]},
    {"from": "commit", "to": "parked", "outcomes": ["failed", "unverified"]},
    {"from": "acceptance", "to": "done", "outcomes": ["completed"]},
    {"from": "acceptance", "to": "implement", "outcomes": ["failed", "unverified"], "kind": "repeat"}
  ]
}
