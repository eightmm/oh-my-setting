{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMS Study Suite Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_id", "cases", "variants", "evaluator", "metric_directions"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "oms-study-suite"},
    "base_id": {"$ref": "#/$defs/id"},
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "input", "expected"],
        "properties": {
          "case_id": {"$ref": "#/$defs/id"}, "input": {}, "expected": {},
          "fixtures": {"type": "object", "maxProperties": 100, "additionalProperties": {"$ref": "#/$defs/path"}}
        }
      }
    },
    "variants": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": {"$ref": "#/$defs/id"},
          "command": {"$ref": "#/$defs/command"},
          "output_format": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,19}$"},
          "params": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
        }
      }
    },
    "repeats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}},
    "evaluator": {"$ref": "#/$defs/command"},
    "metric_directions": {"type": "object", "minProperties": 1, "maxProperties": 50, "additionalProperties": {"enum": ["min", "max"]}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 500, "description": "Normalized non-symlink repository-relative regular file; runtime checks containment and bytes."},
    "command": {
      "type": "object", "additionalProperties": false, "required": ["argv"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 8192}},
        "files": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    }
  },
  "$comment": "Runtime also checks unique case/variant names, finite JSON, maximum 10000 Cartesian cells, real executable availability, and declared file placeholders. Generated immutable suite records include additional captured provenance and are a separate stored representation."
}
