#!/usr/bin/env bash
set -euo pipefail

# One stable entrypoint so any agent CLI (Codex, Claude Code, Antigravity)
# can invoke harness tools by name — `oms run-ledger ...` — without
# memorizing script paths. link.sh puts this on PATH at ~/.local/bin/oms;
# the checkout is resolved from the dispatcher's own symlink target, so a
# dev checkout and an install each dispatch to their own scripts.

# macOS readlink has no -f; walk the link chain by hand (bash 3.2 safe).
resolve_self() {
  local src="$1"
  local dir

  while [ -L "$src" ]; do
    dir="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  printf '%s\n' "$src"
}

SCRIPTS_DIR="$(cd "$(dirname "$(resolve_self "${BASH_SOURCE[0]}")")" && pwd)"

usage() {
  cat <<'EOF'
Usage: oms <tool> [args...]
       oms list
       oms help

Dispatch to an oh-my-setting harness tool by name: `oms run-ledger --help`
runs run-ledger.sh from the install this dispatcher belongs to. `list`
prints public tools with one-line descriptions; docs/COMPONENTS.md in the
install describes each subsystem.

These tools are the agent's hands, not a human command set: every one of them
is meant to be run by Codex, Claude Code, or Antigravity in the middle of a
task. If you are a person reading this, say what you want to your coding
agent instead — it has the harness, the project state, and these tools.
EOF
}

# One-line purpose of a tool: the first sentence of its header comment block
# (before any code line), else of the description under its usage() Usage:
# block. Blank when a script has neither. The block is joined before the
# sentence cut so a description never ends mid-line; "e.g."/"i.e." do not
# terminate the sentence.
describe() {
  local desc

  desc="$(awk '
    function first_sentence(text,  rest, off, i, prefix) {
      rest = text
      off = 0
      while ((i = index(rest, ". ")) > 0) {
        prefix = substr(text, 1, off + i)
        if (prefix !~ /(e\.g|i\.e)\.$/) return prefix
        off += i + 1
        rest = substr(text, off + 1)
      }
      return text
    }
    NR <= 2 { next }
    /^# shellcheck/ { next }
    /^#/ { sub(/^#+ ?/, ""); buf = buf (buf == "" ? "" : " ") $0; next }
    buf != "" { exit }
    /^[[:space:]]*$/ { next }
    { exit }
    END { if (buf != "") print first_sentence(buf) }
  ' "$1")"
  if [ -z "$desc" ]; then
    desc="$(awk '
      function first_sentence(text,  rest, off, i, prefix) {
        rest = text
        off = 0
        while ((i = index(rest, ". ")) > 0) {
          prefix = substr(text, 1, off + i)
          if (prefix !~ /(e\.g|i\.e)\.$/) return prefix
          off += i + 1
          rest = substr(text, off + 1)
        }
        return text
      }
      /^Usage:/ { in_usage = 1; next }
      in_usage && /^EOF$/ { exit }
      in_usage && NF && !/^[[:space:]]/ { buf = buf (buf == "" ? "" : " ") $0; next }
      in_usage && buf != "" { exit }
      END { if (buf != "") print first_sentence(buf) }
    ' "$1")"
  fi
  printf '%s\n' "$desc"
}

is_public_tool() {
  case "$1" in
    apply-project-template|auto-update|change-guard|ci-status|cleanup|code-source|data-manifest|doctor|experiment-board|fail-ledger|gc|generate-slurm-skill|github-source|import-agent-result|install-autoupdate|job-digest|model-doctor|oms-init|provider-permissions|oms-run|patch-admit|patch-land|peer-ask|peer-delegate|peer-review|plan-run|project-doctor|project-private|remove-project-template|repo-state|research-runner|run-capsule|run-ledger|run-reconcile|session-handoff|status|tsp-queue|uninstall|uninstall-autoupdate|update|write-machine-snapshot|advise|agent-call|agent-consult|agent-executor|agent-memory|agent-plan|agent-role|agent-run|agent-task|agent-thread|artifact-index)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

cmd_list() {
  local f
  local name

  for f in "$SCRIPTS_DIR"/*.sh; do
    [ -f "$f" ] || continue
    name="$(basename "$f" .sh)"
    is_public_tool "$name" || continue
    printf '%-26s %s\n' "$name" "$(describe "$f")"
  done
}

case "${1:-}" in
  ""|-h|--help)
    usage
    exit 0
    ;;
  help)
    usage
    echo
    cmd_list
    exit 0
    ;;
  list)
    cmd_list
    exit 0
    ;;
esac

TOOL="$1"
shift
case "$TOOL" in
  *[!A-Za-z0-9._-]*)
    echo "error: invalid tool name: $TOOL" >&2
    exit 2
    ;;
esac
TOOL="${TOOL%.sh}"
# Short aliases for the most-typed tools.
[ "$TOOL" = "run" ] && TOOL="oms-run"      # oms run new|current|show|timeline ...
[ "$TOOL" = "state" ] && TOOL="repo-state" # oms state
[ "$TOOL" = "init" ] && TOOL="oms-init"    # oms init
[ "$TOOL" = "consult" ] && TOOL="agent-consult"  # oms consult "question"
[ "$TOOL" = "thread" ] && TOOL="agent-thread"    # oms thread list|show|new
if ! is_public_tool "$TOOL"; then
  echo "error: unknown tool: $TOOL (run: oms list)" >&2
  exit 2
fi
TARGET="$SCRIPTS_DIR/$TOOL.sh"
if [ ! -f "$TARGET" ]; then
  echo "error: unknown tool: $TOOL (run: oms list)" >&2
  exit 2
fi
RC=0
bash "$TARGET" "$@" || RC=$?
# Exit 2 is the harness misuse convention, so every tool gets one uniform
# recovery hint here instead of per-script wording.
if [ "$RC" -eq 2 ]; then
  echo "hint: run \`oms $TOOL --help\` for usage" >&2
fi
exit "$RC"
