#!/usr/bin/env bash
[ "${BASH_VERSINFO[0]:-0}" -ge 5 ] || { echo "error: oh-my-setting needs Bash 5 or newer (running ${BASH_VERSION:-unknown}); on macOS run: brew install bash, then rerun" >&2; exit 1; }
set -euo pipefail

# Overrides can add a Windows signal, never hide the host identity.
case "${OMS_PLATFORM_OVERRIDE:-$(uname -s)}" in
  windows|Windows|WINDOWS|MINGW*|MSYS*|CYGWIN*)
    echo 'native Windows (Git Bash/MSYS2/Cygwin) is not supported; install inside WSL2 with the repository and home on the Linux filesystem (not /mnt/c).' >&2
    exit 1
    ;;
esac
case "$(uname -s):${OSTYPE:-}" in
  MINGW*|MSYS*|CYGWIN*|*:msys*|*:cygwin*|*:win32)
    echo 'native Windows (Git Bash/MSYS2/Cygwin) is not supported; install inside WSL2 with the repository and home on the Linux filesystem (not /mnt/c).' >&2
    exit 1
    ;;
esac

# One stable entrypoint so any agent CLI (Codex, Claude Code, Antigravity)
# can invoke harness tools by name without memorizing script paths.

resolve_self() {
  local src="$1" dir
  while [ -L "$src" ]; do
    dir="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  printf '%s\n' "$src"
}

# Pure-awk schema=2 install receipt source_root extractor (works on minimal PATH).
read_receipt_source_root() {
  local receipt="$1"
  [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
  awk '
    { text = text $0 "\n" }
    END {
      if (index(text, "\\") != 0) exit 1
      n = length(text); depth = 0; lists = 0; key = ""; value = 0
      schema = ""; root = ""
      for (i = 1; i <= n; i++) {
        c = substr(text, i, 1)
        if (c == "\"") {
          s = ""
          for (i++; i <= n && (d = substr(text, i, 1)) != "\""; i++) {
            if (d == "\\") { i++; d = substr(text, i, 1) }
            s = s d
          }
          if (lists) continue
          if (value) {
            if (depth == 1 && key == "source_root") root = s
            value = 0
          } else key = s
        } else if (c == ":") value = 1
        else if (c == "{") { depth++; value = 0 }
        else if (c == "}") depth--
        else if (c == "[") lists++
        else if (c == "]") lists--
        else if (c == ",") value = 0
        else if (value && !lists && c ~ /[-0-9]/) {
          s = c
          while (i < n && index(",}] \t\r\n", substr(text, i + 1, 1)) == 0) s = s substr(text, ++i, 1)
          if (depth == 1 && key == "schema") schema = s
          value = 0
        }
      }
      if (schema == "2" && substr(root, 1, 1) == "/") print root
      else exit 1
    }
  ' "$receipt"
}

SCRIPTS_DIR="$(cd "$(dirname "$(resolve_self "${BASH_SOURCE[0]}")")" && pwd)"
ROOT="$(cd "$SCRIPTS_DIR/.." && pwd -P)"

if [ ! -f "$SCRIPTS_DIR/lib/platform.sh" ]; then
  receipt="${OMS_INSTALL_RECEIPT:-${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-setting/install.json}"
  source_root="$(read_receipt_source_root "$receipt" 2>/dev/null || true)"
  source_root="${source_root//$'\r'/}"
  if [ -n "$source_root" ] && [ -f "$source_root/scripts/lib/platform.sh" ]; then
    SCRIPTS_DIR="$source_root/scripts"
    ROOT="$source_root"
  else
    echo "error: oms cannot locate its checkout from $SCRIPTS_DIR" >&2
    echo "error: no harness scripts there and no usable install receipt at $receipt" >&2
    echo "error: reinstall, or run scripts/oms from the checkout directly" >&2
    exit 1
  fi
fi

# shellcheck source=scripts/lib/platform.sh
. "$SCRIPTS_DIR/lib/platform.sh"
oms_bash_enter

native_outcome=absent
unset OMS_NATIVE_OUTCOME
if [ -e "$ROOT/rust/target/oms-native" ] || [ -L "$ROOT/rust/target/oms-native" ] ||
   { [ -f "$ROOT/rust/Cargo.toml" ] && [ "${OMS_NATIVE_NO_AUTO_STAGE:-0}" != 1 ] && command -v cargo >/dev/null 2>&1; }; then
  native_args=("$@")
  if [ "$#" -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then native_args=(panel); fi
  if [ "${#native_args[@]}" -gt 0 ] && [ -n "${native_args[0]}" ]; then
    native_policy=strict
    case "${native_args[0]}" in doctor|uninstall) native_policy=recover ;; esac
    oms_native_route "$native_policy" "$ROOT" "${native_args[@]}" || exit
    native_outcome="$OMS_NATIVE_OUTCOME"
  fi
fi
export OMS_NATIVE_OUTCOME="$native_outcome"

usage() {
  cat <<'EOF_USAGE'
Usage: oms <tool> [args...]
       oms                         # terminal control panel (interactive TTY)
       oms list [--all]
       oms help

Dispatch to the native oh-my-setting Rust CLI by name. `list` prints the
frontdoor entrypoints; `list --all` reveals core primitives.
EOF_USAGE
}

case "${1:-}" in
  "")
    if [ -t 0 ] && [ -t 1 ]; then
      exec bash "$SCRIPTS_DIR/panel.sh"
    fi
    usage
    exit 0
    ;;
  -h|--help|help|list)
    if [ "${1:-}" = -h ] || [ "${1:-}" = --help ]; then
      usage
      exit 0
    fi
    echo "error: native payload unavailable ($native_outcome); build with cargo or run oms doctor --repair" >&2
    exit 2
    ;;
esac

TOOL="$1"
shift
case "$TOOL" in
  *[!A-Za-z0-9._-]*)
    echo "error: invalid tool name: $TOOL" >&2
    exit 2
    ;;
esac
TOOL="${TOOL%.sh}"
TARGET="$SCRIPTS_DIR/$TOOL.sh"
if [ ! -f "$TARGET" ]; then
  echo "error: unknown tool: $TOOL (run: oms list --all)" >&2
  exit 2
fi
if [ "$TOOL" = panel ] || [ "$TOOL" = harness ]; then
  exec bash "$TARGET" "$@"
fi
RC=0
bash "$TARGET" "$@" || RC=$?
exit "$RC"
