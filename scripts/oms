#!/usr/bin/env bash
[ "${BASH_VERSINFO[0]:-0}" -ge 5 ] || { echo "error: oh-my-setting needs Bash 5 or newer (running ${BASH_VERSION:-unknown}); on macOS run: brew install bash, then rerun" >&2; exit 1; }
set -euo pipefail

# Overrides can add a Windows signal, never hide the host identity.
# Refuse before any lifecycle lock, checkout lookup or state write.
case "${OMS_PLATFORM_OVERRIDE:-$(uname -s)}" in
  windows|Windows|WINDOWS|MINGW*|MSYS*|CYGWIN*)
    echo 'native Windows (Git Bash/MSYS2/Cygwin) is not supported; install inside WSL2 with the repository and home on the Linux filesystem (not /mnt/c).' >&2
    exit 1
    ;;
esac
case "$(uname -s):${OSTYPE:-}" in
  MINGW*|MSYS*|CYGWIN*|*:msys*|*:cygwin*|*:win32)
    echo 'native Windows (Git Bash/MSYS2/Cygwin) is not supported; install inside WSL2 with the repository and home on the Linux filesystem (not /mnt/c).' >&2
    exit 1
    ;;
esac

# One stable entrypoint so any agent CLI (Codex, Claude Code, Antigravity)
# can invoke harness tools by name — `oms run-ledger ...` — without
# memorizing script paths. link.sh puts this on PATH at ~/.local/bin/oms;
# symlink installs resolve the checkout from that link, while copy installs
# recover the canonical checkout from the install receipt.

resolve_self() {
  local src="$1"
  local dir

  while [ -L "$src" ]; do
    dir="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  printf '%s\n' "$src"
}

receipt_runtime_safe() {
  local root="$1" version env marker candidate path target parent managed count old_ifs
  [ ! -L "$root" ] && [ -d "$root" ] && [ ! -L "$root/bin" ] &&
    [ ! -L "$root/bin/python3" ] && [ -f "$root/bin/python3" ] && [ -x "$root/bin/python3" ] || return 1
  marker="$root/.oh-my-setting-python-runtime"
  [ ! -L "$marker" ] && [ -f "$marker" ] &&
    [ "$(sed -n '1p' "$marker")" = schema=1 ] && [ "$(sed -n '2p' "$marker")" = owner=oh-my-setting ] || return 1
  [ ! -L "$root/current" ] && [ -f "$root/current" ] || return 1
  IFS= read -r version < "$root/current" || return 1
  case "$version" in ''|*[!0-9.]*|.*|*.|*..*) return 1 ;; esac
  old_ifs="$IFS"; IFS=.; set -- $version; IFS="$old_ifs"
  [ "$#" -eq 3 ] && [ -n "$1" ] && [ -n "$2" ] && [ -n "$3" ] || return 1
  env="$root/envs/$version"
  marker="$env/.oh-my-setting-python-env"
  [ ! -L "$root/envs" ] && [ ! -L "$env" ] && [ -d "$env" ] &&
    [ ! -L "$marker" ] && [ -f "$marker" ] &&
    [ "$(sed -n '1p' "$marker")" = schema=1 ] && [ "$(sed -n '2p' "$marker")" = "version=$version" ] || return 1
  for candidate in "$env/bin/python3" "$env/bin/python"; do
    [ ! -L "${candidate%/*}" ] && [ -f "$candidate" ] && [ -x "$candidate" ] || continue
    if [ ! -L "$candidate" ]; then printf '%s\n' "$candidate"; return 0; fi
    [ ! -L "$root/managed" ] && [ -d "$root/managed" ] || continue
    managed="$(cd "$root/managed" && pwd -P)" || continue
    path="$candidate"; count=0
    while [ -L "$path" ]; do
      count=$((count + 1)); [ "$count" -le 32 ] || return 1
      parent="${path%/*}"; parent="$(cd "${parent:-/}" && pwd -P)" || return 1
      target="$(readlink "$path")" || return 1
      case "$target" in /*) path="$target" ;; *) path="$parent/$target" ;; esac
    done
    parent="${path%/*}"; parent="$(cd "${parent:-/}" && pwd -P)" || return 1
    case "$parent/${path##*/}" in "$managed"/*) printf '%s\n' "$candidate"; return 0 ;; esac
  done
  return 1
}

SCRIPTS_DIR="$(cd "$(dirname "$(resolve_self "${BASH_SOURCE[0]}")")" && pwd)"
ROOT="$(cd "$SCRIPTS_DIR/.." && pwd -P)"
if [ -f "$SCRIPTS_DIR/lib/platform.sh" ]; then
  # shellcheck source=scripts/lib/platform.sh
  . "$SCRIPTS_DIR/lib/platform.sh"
  oms_bash_enter
fi
if [ -f "$SCRIPTS_DIR/lib/python-runtime.sh" ]; then
  # shellcheck source=scripts/lib/python-runtime.sh
  . "$SCRIPTS_DIR/lib/python-runtime.sh"
  oms_python_runtime_activate_if_present
fi
if [ ! -f "$SCRIPTS_DIR/agent-task.sh" ]; then
  receipt="${OMS_INSTALL_RECEIPT:-${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-setting/install.json}"
  source_root=""
  # A copied dispatcher has no adjacent library until this JSON bootstrap
  # finds the checkout. Use the host interpreter in isolated mode.
  unset -f python python3 2>/dev/null || true
  runtime_root="${OMS_PYTHON_RUNTIME_ROOT:-$HOME/.local/share/oh-my-setting/python-runtime}"
  if ! receipt_python="$(receipt_runtime_safe "$runtime_root")"; then
    receipt_python="$(command -v python3 2>/dev/null || true)"
    case "$receipt_python" in "$runtime_root"/*|"$HOME/.local/bin/python3") receipt_python="" ;; esac
  fi
  if [ -n "$receipt_python" ]; then
    source_root="$(env -u PYTHONHOME -u PYTHONPATH "$receipt_python" -I - "$receipt" <<'PY' 2>/dev/null || true
import json
import os
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        row = json.load(handle)
    root = row.get("source_root", "")
    if row.get("schema") == 2 and isinstance(root, str) and os.path.isabs(root):
        print(root)
except (OSError, ValueError):
    pass
PY
)"
  fi
  source_root="${source_root//$'\r'/}"
  if [ -n "$source_root" ] && [ -f "$source_root/scripts/agent-task.sh" ]; then
    SCRIPTS_DIR="$source_root/scripts"
    ROOT="$source_root"
    if [ -f "$SCRIPTS_DIR/lib/platform.sh" ]; then
      # shellcheck source=scripts/lib/platform.sh
      . "$SCRIPTS_DIR/lib/platform.sh"
      oms_bash_enter
    fi
    if [ -f "$SCRIPTS_DIR/lib/python-runtime.sh" ]; then
      # shellcheck source=scripts/lib/python-runtime.sh
      . "$SCRIPTS_DIR/lib/python-runtime.sh"
      oms_python_runtime_activate_if_present
    fi
  else
    echo "error: oms cannot locate its checkout from $SCRIPTS_DIR" >&2
    echo "error: no harness scripts there and no usable install receipt at $receipt" >&2
    echo "error: reinstall, or run scripts/oms from the checkout directly" >&2
    exit 1
  fi
fi

usage() {
  cat <<'EOF_USAGE'
Usage: oms <tool> [args...]
       oms                         # terminal control panel (interactive TTY)
       oms list [--all]
       oms help

Dispatch to an oh-my-setting harness tool by name. `list` prints the compact
subsystem entrypoints; `list --all` reveals core primitives. The command-routing
reference selects intent variants behind those entries. Docs/COMPONENTS.md
describes the existing subsystems and docs/OMS-RUNTIME.md explains the typed
runtime projection.

The terminal panel is the human entrypoint. The other tools are the agent's
hands; give your coding agent the goal instead of composing harness commands.
EOF_USAGE
}

describe() {
  awk '
    function first_sentence(text,  rest, off, i, prefix) {
      rest = text
      off = 0
      while ((i = index(rest, ". ")) > 0) {
        prefix = substr(text, 1, off + i)
        if (prefix !~ /(e\.g|i\.e)\.$/) return prefix
        off += i + 1
        rest = substr(text, off + 1)
      }
      return text
    }
    NR > 2 && !header_done {
      if ($0 ~ /^# shellcheck/) {
      } else if ($0 ~ /^#/) {
        text = $0
        sub(/^#+ ?/, "", text)
        buf = buf (buf == "" ? "" : " ") text
      } else if (buf != "" || $0 !~ /^[[:space:]]*$/) {
        header_done = 1
      }
      if (header_done && buf != "") exit
    }
    /^Usage:/ { in_usage = 1; next }
    in_usage && /^EOF$/ { exit }
    in_usage && NF && !/^[[:space:]]/ { usage = usage (usage == "" ? "" : " ") $0; next }
    in_usage && usage != "" { exit }
    END { print first_sentence(buf != "" ? buf : usage) }
  ' "$1"
}

