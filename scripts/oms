#!/usr/bin/env bash
set -euo pipefail

# One stable entrypoint so any agent CLI (Codex, Claude Code, Antigravity)
# can invoke harness tools by name — `oms run-ledger ...` — without
# memorizing script paths. link.sh puts this on PATH at ~/.local/bin/oms;
# symlink installs resolve the checkout from that link, while copy installs
# recover the canonical checkout from the install receipt.

resolve_self() {
  local src="$1"
  local dir

  while [ -L "$src" ]; do
    dir="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  printf '%s\n' "$src"
}

SCRIPTS_DIR="$(cd "$(dirname "$(resolve_self "${BASH_SOURCE[0]}")")" && pwd)"
if [ ! -f "$SCRIPTS_DIR/agent-task.sh" ]; then
  receipt="${OMS_INSTALL_RECEIPT:-${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-setting/install.json}"
  source_root=""
  if command -v python3 >/dev/null 2>&1; then
    source_root="$(python3 - "$receipt" <<'PY' 2>/dev/null || true
import json
import os
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        row = json.load(handle)
    root = row.get("source_root", "")
    if row.get("schema") == 2 and isinstance(root, str) and os.path.isabs(root):
        print(root)
except (OSError, ValueError):
    pass
PY
)"
  fi
  source_root="${source_root//$'\r'/}"
  if [ -n "$source_root" ] && command -v cygpath >/dev/null 2>&1; then
    source_root="$(cygpath -u "$source_root")"
  fi
  if [ -n "$source_root" ] && [ -f "$source_root/scripts/agent-task.sh" ]; then
    SCRIPTS_DIR="$source_root/scripts"
  else
    echo "error: oms cannot locate its checkout from $SCRIPTS_DIR" >&2
    echo "error: no harness scripts there and no usable install receipt at $receipt" >&2
    echo "error: reinstall, or run scripts/oms from the checkout directly" >&2
    exit 1
  fi
fi

usage() {
  cat <<'EOF_USAGE'
Usage: oms <tool> [args...]
       oms list [--frontdoor|--all]
       oms help

Dispatch to an oh-my-setting harness tool by name. `list` and `list --all`
print the full public catalog; `list --frontdoor` prints the small stable set of
agent-facing subsystem entrypoints. The `oms-agent-harness` command-routing
reference selects intent variants behind those entries. Docs/COMPONENTS.md
describes the existing subsystems and docs/OMS-RUNTIME.md explains the typed
runtime projection.

These tools are the agent's hands, not a human command set. If you are a person
reading this, say what you want to your coding agent instead.
EOF_USAGE
}

describe() {
  local desc

  desc="$(awk '
    function first_sentence(text,  rest, off, i, prefix) {
      rest = text
      off = 0
      while ((i = index(rest, ". ")) > 0) {
        prefix = substr(text, 1, off + i)
        if (prefix !~ /(e\.g|i\.e)\.$/) return prefix
        off += i + 1
        rest = substr(text, off + 1)
      }
      return text
    }
    NR <= 2 { next }
    /^# shellcheck/ { next }
    /^#/ { sub(/^#+ ?/, ""); buf = buf (buf == "" ? "" : " ") $0; next }
    buf != "" { exit }
    /^[[:space:]]*$/ { next }
    { exit }
    END { if (buf != "") print first_sentence(buf) }
  ' "$1")"
  if [ -z "$desc" ]; then
    desc="$(awk '
      function first_sentence(text,  rest, off, i, prefix) {
        rest = text
        off = 0
        while ((i = index(rest, ". ")) > 0) {
          prefix = substr(text, 1, off + i)
          if (prefix !~ /(e\.g|i\.e)\.$/) return prefix
          off += i + 1
          rest = substr(text, off + 1)
        }
        return text
      }
      /^Usage:/ { in_usage = 1; next }
      in_usage && /^EOF$/ { exit }
      in_usage && NF && !/^[[:space:]]/ { buf = buf (buf == "" ? "" : " ") $0; next }
      in_usage && buf != "" { exit }
      END { if (buf != "") print first_sentence(buf) }
    ' "$1")"
  fi
  printf '%s\n' "$desc"
}

OMS_PUBLIC_TOOLS="
advise
agent-call
agent-events
agent-executor
agent-memory
agent-plan
agent-role
agent-run
agent-supervisor
agent-task
apply-project-template
approval-inbox
artifact-index
auto-update
autopilot
change-guard
checkpoint
ci-status
cleanup
consult
data-manifest
doctor
draft-pr
execution-profile
experiment-board
fail-ledger
gc
goal-drive
herdr-adapter
inbox
init
install-profile
intent
job-digest
journal
model-doctor
models
open-in
ops-cockpit
otel-export
patch-admit
patch-land
peer-ask
peer-delegate
peer-review
plan-from-spec
plan-run
project-doctor
project-private
provider-permissions
remove-project-template
research-runner
run
run-ledger
run-reconcile
runtime
semantic-eval
session-handoff
skill-doctor
skill-forge
snapshot
state
state-verify
status
support-bundle
thread
tsp-queue
uninstall
update
"

OMS_FRONTDOOR_TOOLS="
autopilot
consult
doctor
inbox
journal
patch-admit
patch-land
peer-delegate
peer-review
runtime
update
"

tool_in_list() {
  case "$2" in
    *"
$1
"*) return 0 ;;
    *) return 1 ;;
  esac
}

is_public_tool() {
  tool_in_list "$1" "$OMS_PUBLIC_TOOLS"
}

cmd_list() {
  local selected="$1"
  local f
  local name

  for f in "$SCRIPTS_DIR"/*.sh; do
    [ -f "$f" ] || continue
    name="$(basename "$f" .sh)"
    tool_in_list "$name" "$selected" || continue
    printf '%-26s %s\n' "$name" "$(describe "$f")"
  done
}

case "${1:-}" in
  ""|-h|--help)
    usage
    exit 0
    ;;
  help)
    usage
    echo
    cmd_list "$OMS_PUBLIC_TOOLS"
    exit 0
    ;;
  list)
    case "${2:-}" in
      ""|--all) cmd_list "$OMS_PUBLIC_TOOLS" ;;
      --frontdoor) cmd_list "$OMS_FRONTDOOR_TOOLS" ;;
      *) echo "error: oms list accepts --frontdoor or --all" >&2; exit 2 ;;
    esac
    exit 0
    ;;
esac

TOOL="$1"
shift
case "$TOOL" in
  *[!A-Za-z0-9._-]*)
    echo "error: invalid tool name: $TOOL" >&2
    exit 2
    ;;
esac
TOOL="${TOOL%.sh}"
if ! is_public_tool "$TOOL"; then
  echo "error: unknown tool: $TOOL (run: oms list --all)" >&2
  exit 2
fi
TARGET="$SCRIPTS_DIR/$TOOL.sh"
if [ ! -f "$TARGET" ]; then
  echo "error: unknown tool: $TOOL (run: oms list --all)" >&2
  exit 2
fi
RC=0
bash "$TARGET" "$@" || RC=$?
if [ "$RC" -eq 2 ]; then
  echo "hint: run \`oms $TOOL --help\` for usage" >&2
fi
exit "$RC"
