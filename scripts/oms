tool_in_list() {
  case "$2" in
    *"
$1
"*) return 0 ;;
    *) return 1 ;;
  esac
}

is_public_tool() {
  tool_in_list "$1" "$OMS_PUBLIC_TOOLS"
}

cmd_list() {
  local selected="$1"
  local name

  while IFS= read -r name; do
    case "$name" in
      "") continue ;;
      "# "*) printf '%s:\n' "${name#\# }"; continue ;;
    esac
    [ -f "$SCRIPTS_DIR/$name.sh" ] || continue
    printf '%-26s %s\n' "$name" "$(describe "$SCRIPTS_DIR/$name.sh")"
  done <<EOF_LIST
$selected
EOF_LIST
}

case "${1:-}" in
  "")
    if [ -t 0 ] && [ -t 1 ]; then
      oms_python_runtime_require || exit 1
      exec bash "$SCRIPTS_DIR/panel.sh"
    fi
    usage
    exit 0
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  help)
    usage
    echo
    cmd_list "$OMS_FRONTDOOR_TOOLS"
    exit 0
    ;;
  list)
    case "${2:-}" in
      "") cmd_list "$OMS_FRONTDOOR_TOOLS" ;;
      --all) cmd_list "$OMS_PUBLIC_TOOLS" ;;
      *) echo "error: oms list accepts --all" >&2; exit 2 ;;
    esac
    exit 0
    ;;
esac

TOOL="$1"
shift
case "$TOOL" in
  *[!A-Za-z0-9._-]*)
    echo "error: invalid tool name: $TOOL" >&2
    exit 2
    ;;
esac
TOOL="${TOOL%.sh}"
if ! is_public_tool "$TOOL"; then
  echo "error: unknown tool: $TOOL (run: oms list --all)" >&2
  exit 2
fi
TARGET="$SCRIPTS_DIR/$TOOL.sh"
if [ ! -f "$TARGET" ]; then
  echo "error: unknown tool: $TOOL (run: oms list --all)" >&2
  exit 2
fi
needs_python=1
case "$TOOL" in doctor|uninstall) needs_python=0 ;; esac
for arg in "$@"; do
  case "$arg" in --help|-h) needs_python=0 ;; esac
done
[ "$needs_python" = 0 ] || oms_python_runtime_require || exit 1
if [ "$TOOL" = panel ] || [ "$TOOL" = harness ]; then
  # Interactive entrypoints own the caller PID so signals reach their cleanup.
  exec bash "$TARGET" "$@"
fi
RC=0
bash "$TARGET" "$@" || RC=$?
if [ "$RC" -eq 2 ]; then
  echo "hint: run \`oms $TOOL --help\` for usage" >&2
fi
exit "$RC"
